<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <!-- 圆角按容器层级定义；颜色继续跟随系统深浅主题与高对比度。 -->
    <CornerRadius x:Key="STRadiusWindow">20</CornerRadius>
    <CornerRadius x:Key="STRadiusCard">16</CornerRadius>
    <CornerRadius x:Key="STRadiusControl">10</CornerRadius>
    <CornerRadius x:Key="STRadiusPill">20</CornerRadius>
    <Thickness x:Key="STSpacePage">16</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="WindowCornerRadius">20</CornerRadius>

    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{DynamicResource STRadiusControl}" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="ToggleButton">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{DynamicResource STRadiusControl}" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{DynamicResource STRadiusControl}" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type ui:SettingsCard}}" TargetType="ui:SettingsCard">
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{DynamicResource STRadiusCard}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
</ResourceDictionary>
