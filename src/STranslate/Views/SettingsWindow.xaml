<Window
    x:Class="STranslate.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cnvt="clr-namespace:STranslate.Converters"
    xmlns:control="clr-namespace:STranslate.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:STranslate.Views.Pages"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.ViewModels"
    x:Name="STSettingsWindow"
    Title="{DynamicResource Settings}"
    Width="1040"
    Height="760"
    MinWidth="940"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=vm:SettingsWindowViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:TitleBar.ExtendViewIntoTitleBar="True"
    ui:TitleBar.Height="48"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:WindowHelper.UseModernWindowStyle="True"
    Icon="/Resources/app.ico"
    KeyDown="OnKeyDown"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding
            Key="Esc"
            Command="{Binding CancelCommand}"
            CommandParameter="{Binding ElementName=STSettingsWindow}" />
    </Window.InputBindings>

    <Grid>
        <Border
            Height="{Binding ElementName=RootNavigation, Path=CompactPaneLength}"
            Margin="24,0,0,0"
            VerticalAlignment="Top"
            Background="Transparent"
            IsHitTestVisible="True">
            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                <Image Width="20" Source="pack://application:,,,/Resources/app.ico" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{DynamicResource CaptionTextBlockStyle}"
                    Text="{DynamicResource Settings}"
                    TextWrapping="NoWrap" />
            </ikw:SimpleStackPanel>
        </Border>
        <ui:NavigationView
            x:Name="RootNavigation"
            Margin="6,0"
            AlwaysShowHeader="False"
            Canvas.ZIndex="0"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            IsPaneToggleButtonVisible="False"
            IsTabStop="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="224"
            PaneDisplayMode="Left"
            SelectionChanged="OnNaviSelectionChanged">
            <ui:NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentMargin">0,48,0,0</Thickness>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">20,0,0,0</CornerRadius>
                <Thickness x:Key="NavigationViewHeaderMargin">20,0,0,0</Thickness>
                <sys:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</sys:Double>
                <Style BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}" TargetType="ui:NavigationViewItem">
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Margin" Value="6,2" />
                    <Setter Property="ui:ControlHelper.CornerRadius" Value="{DynamicResource STRadiusControl}" />
                </Style>
            </ui:NavigationView.Resources>
            <ui:NavigationView.PaneCustomContent>
                <StackPanel Margin="18,58,12,24" Orientation="Horizontal">
                    <Image
                        Width="32"
                        Height="32"
                        Source="/Resources/app.ico" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        FontSize="18"
                        Text="STranslate"
                        TextAlignment="Center" />
                </StackPanel>
            </ui:NavigationView.PaneCustomContent>
            <ui:NavigationView.MenuItems>

                <ui:NavigationViewItem Content="{DynamicResource General}" Tag="GeneralPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Settings_20_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{DynamicResource Services}" IsExpanded="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Apps_20_Regular}" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="{DynamicResource Translate}" Tag="TranslatePage">
                            <ui:NavigationViewItem.Icon>
                                <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Translate_24_Regular}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{DynamicResource Ocr}" Tag="OcrPage">
                            <ui:NavigationViewItem.Icon>
                                <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.ScanType_20_Regular}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{DynamicResource Tts}" Tag="TtsPage">
                            <ui:NavigationViewItem.Icon>
                                <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Speaker2_20_Regular}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{DynamicResource Vocabulary}" Tag="VocabularyPage">
                            <ui:NavigationViewItem.Icon>
                                <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Book_20_Regular}" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{DynamicResource Standalone}" Tag="StandalonePage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.WindowAd_24_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{DynamicResource History}" Tag="HistoryPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.History_20_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{DynamicResource Plugins}" Tag="PluginPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Box_24_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{DynamicResource Hotkeys}" Tag="HotkeyPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Keyboard_24_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{DynamicResource Network}" Tag="NetworkPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Globe_20_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{DynamicResource About}" Tag="AboutPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontSize="20" Icon="{x:Static ui:FluentSystemIcons.Info_24_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

            </ui:NavigationView.MenuItems>

            <Border Margin="0,8,12,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource STRadiusCard}">
                <ui:Frame x:Name="RootFrame" />
            </Border>
        </ui:NavigationView>
    </Grid>
</Window>
