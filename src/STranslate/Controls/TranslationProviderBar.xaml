<UserControl x:Class="STranslate.Controls.TranslationProviderBar" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:control="clr-namespace:STranslate.Controls"
 xmlns:cnvt="clr-namespace:STranslate.Converters"
 xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
 <Grid>
  <ToggleButton x:Name="Trigger" Height="34" MaxWidth="220" Padding="10,4"
   ui:ControlHelper.CornerRadius="12" ToolTip="{DynamicResource TranslationProviders}"
   AutomationProperties.Name="{DynamicResource TranslationProviders}">
   <ToggleButton.Template>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Face" CornerRadius="11" Padding="{TemplateBinding Padding}" Background="{DynamicResource SettingsCardBackground}" BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1">
      <ContentPresenter VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </ToggleButton.Template>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Width="20" Height="20" Margin="0,0,7,0" Source="{Binding SelectedProvider.IconPath, ElementName=Root, Converter={cnvt:ImagePathToSourceConverter}}"/>
    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SelectionLabel, ElementName=Root}"/>
    <Path Grid.Column="2" Margin="9,0,0,0" Width="10" Height="6" VerticalAlignment="Center"
     Data="M 1,1 L 5,5 L 9,1" Stroke="{Binding Foreground, ElementName=Trigger}" StrokeThickness="1.5"
     StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin=".5,.5">
     <Path.RenderTransform><RotateTransform x:Name="Arrow"/></Path.RenderTransform>
    </Path>
   </Grid>
  </ToggleButton>
  <control:ServiceSwitcherPopup x:Name="Menu" AllowsTransparency="True" CloseOnSelection="True" DropDown="True"
   Placement="Bottom" PlacementTarget="{Binding ElementName=Trigger}" VerticalOffset="4"
   IsExpanded="{Binding IsChecked, ElementName=Trigger, Mode=TwoWay}"
   DataContext="{Binding DataContext, ElementName=Root}">
   <Border Width="240" Margin="4,4,4,18" Padding="6" CornerRadius="16"
    Background="{DynamicResource {x:Static ui:ThemeKeys.SolidBackgroundFillColorBaseBrushKey}}"
    BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1"
    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
    <StackPanel>
     <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="Providers" ItemsSource="{Binding TranslateService.Services}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Margin="0,2" Padding="0" HorizontalContentAlignment="Stretch"
          ToolTip="{Binding DisplayName}" AutomationProperties.Name="{Binding DisplayName}"
          Command="{Binding DataContext.SelectTranslationProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
          <Button.Template>
           <ControlTemplate TargetType="Button">
            <Border x:Name="Row" Padding="10,8" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">

   <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Image Width="24" Height="24" Margin="0,0,10,0" Source="{Binding IconPath, Converter={cnvt:ImagePathToSourceConverter}}"/>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="Selected" Grid.Column="2" Margin="10,0,0,0" Text="✓" VerticalAlignment="Center" Visibility="Hidden" Foreground="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/>
             </Grid>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SettingsCardBackground}"/></Trigger>
             <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/></Trigger>
             <DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter TargetName="Selected" Property="Visibility" Value="Visible"/></DataTrigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Button.Template>
         </Button>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <Button Margin="0,5,0,0" Padding="10,7" HorizontalContentAlignment="Left" Content="{DynamicResource Settings}" Command="{Binding OpenSettingsCommand}"/>
    </StackPanel>
   </Border>
  </control:ServiceSwitcherPopup>
 </Grid>
</UserControl>