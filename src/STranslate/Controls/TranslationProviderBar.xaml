<UserControl x:Class="STranslate.Controls.TranslationProviderBar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:cnvt="clr-namespace:STranslate.Converters"
 xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
 <Border CornerRadius="16" Padding="10,8" Background="{DynamicResource SettingsCardBackground}" BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1">
  <StackPanel>
   <DockPanel Margin="4,0,4,6">
    <Button DockPanel.Dock="Right" Padding="8,3" Command="{Binding OpenSettingsCommand}" Content="{DynamicResource Settings}" />
    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource TranslationProviders}" />
   </DockPanel>
   <ItemsControl x:Name="Providers" ItemsSource="{Binding TranslateService.Services}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Button Width="84" Margin="2,2" Padding="0" ToolTip="{Binding DisplayName}" AutomationProperties.Name="{Binding DisplayName}"
       Command="{Binding DataContext.SelectTranslationProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
       CommandParameter="{Binding}" Loaded="OnProviderLoaded">
       <Button.RenderTransform><TranslateTransform /></Button.RenderTransform>
       <Button.Template>
        <ControlTemplate TargetType="Button">
         <Border x:Name="Tile" CornerRadius="12" Padding="5,7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
          <StackPanel>
           <Grid Width="44" Height="44">
            <Border x:Name="Ring" CornerRadius="22" BorderThickness="2" BorderBrush="{DynamicResource SettingsCardBorderBrush}" Background="{DynamicResource SettingsCardBackground}">
             <Image Width="28" Height="28" Stretch="Uniform" Source="{Binding IconPath, Converter={cnvt:ImagePathToSourceConverter}}" />
            </Border>
            <Border x:Name="Selected" Width="15" Height="15" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}" Visibility="Collapsed">
             <TextBlock Text="✓" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
           </Grid>
           <TextBlock x:Name="Label" Margin="0,6,0,0" Text="{Binding DisplayName}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SettingsCardBackground}" /><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}" /></Trigger>
          <DataTrigger Binding="{Binding IsEnabled}" Value="True">
           <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}" />
           <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
           <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
          </DataTrigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Button.Template>
      </Button>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <Button Padding="12,9" HorizontalAlignment="Left" Content="{DynamicResource AddTranslationProvider}" Command="{Binding OpenSettingsCommand}" Visibility="{Binding ElementName=Providers, Path=HasItems, Converter={cnvt:BoolToVisibilityInverseConverter}}" />
  </StackPanel>
 </Border>
</UserControl>
