<UserControl x:Class="STranslate.Controls.TranslationProviderBar" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:control="clr-namespace:STranslate.Controls"
 xmlns:cnvt="clr-namespace:STranslate.Converters"
 xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
 <UserControl.Resources>
  <Style x:Key="FloatingProviderButton" TargetType="Button">
   <Setter Property="Width" Value="44"/>
   <Setter Property="Height" Value="44"/>
   <Setter Property="Margin" Value="0,5"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Circle" CornerRadius="22" Background="{DynamicResource {x:Static ui:ThemeKeys.SolidBackgroundFillColorBaseBrushKey}}"
       BorderThickness="1" BorderBrush="{DynamicResource SettingsCardBorderBrush}">
       <Border.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.16"/></Border.Effect>
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/><Setter TargetName="Circle" Property="BorderThickness" Value="2"/></Trigger>
       <DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/><Setter TargetName="Circle" Property="BorderThickness" Value="2"/></DataTrigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <ToggleButton x:Name="Trigger" Width="58" Height="36" Padding="8,4"
   ToolTip="{Binding SelectionLabel, ElementName=Root}" AutomationProperties.Name="{Binding SelectionLabel, ElementName=Root}">
   <ToggleButton.Template>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Face" CornerRadius="11" Padding="{TemplateBinding Padding}" Background="{DynamicResource SettingsCardBackground}" BorderBrush="{DynamicResource SettingsCardBorderBrush}" BorderThickness="1">
      <ContentPresenter VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.AccentTextFillColorPrimaryBrushKey}}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </ToggleButton.Template>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Width="22" Height="22" Source="{Binding SelectedProvider.IconPath, ElementName=Root, Converter={cnvt:ImagePathToSourceConverter}}"/>
    <TextBlock Text="译" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProvider, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <Path Grid.Column="1" Margin="7,0,0,0" Width="10" Height="6" VerticalAlignment="Center"
     Data="M 1,1 L 5,5 L 9,1" Stroke="{Binding Foreground, ElementName=Trigger}" StrokeThickness="1.5"
     StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin=".5,.5">
     <Path.RenderTransform><RotateTransform x:Name="Arrow"/></Path.RenderTransform>
    </Path>
   </Grid>
  </ToggleButton>
  <control:ServiceSwitcherPopup x:Name="Menu" AllowsTransparency="True" CloseOnSelection="True" DropDown="True"
   Placement="Bottom" PlacementTarget="{Binding ElementName=Trigger}" HorizontalOffset="-9" VerticalOffset="1"
   IsExpanded="{Binding IsChecked, ElementName=Trigger, Mode=TwoWay}" DataContext="{Binding DataContext, ElementName=Root}">
   <!-- 透明底上逐个悬浮圆钮，留出阴影和位移动画的余量，不绘制整块菜单背景。 -->
   <Border Width="76" Padding="0,12,0,12" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
    <StackPanel>
     <ScrollViewer MaxHeight="324" Padding="6,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
      <ItemsControl x:Name="Providers" ItemsSource="{Binding TranslateService.Services}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Style="{StaticResource FloatingProviderButton}" ToolTip="{Binding DisplayName}" AutomationProperties.Name="{Binding DisplayName}"
          Command="{Binding DataContext.SelectTranslationProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
          <Image Width="30" Height="30" Stretch="Uniform" Source="{Binding IconPath, Converter={cnvt:ImagePathToSourceConverter}}"/>
         </Button>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <Button Style="{StaticResource FloatingProviderButton}" Content="+" FontSize="22"
      ToolTip="{DynamicResource AddTranslationProvider}" AutomationProperties.Name="{DynamicResource AddTranslationProvider}"
      Command="{Binding OpenSettingsCommand}" Visibility="{Binding ElementName=Providers, Path=HasItems, Converter={cnvt:BoolToVisibilityInverseConverter}}"/>
    </StackPanel>
   </Border>
  </control:ServiceSwitcherPopup>
 </Grid>
</UserControl>