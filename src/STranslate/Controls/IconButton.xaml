<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:STranslate.Controls"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <!-- 显式底座避免局部同类型隐式样式在主题加载时丢失 BasedOn。 -->
    <Style x:Key="STIconButtonStyle" TargetType="{x:Type control:IconButton}">
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="ui:ControlHelper.CornerRadius" Value="{DynamicResource STRadiusControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IconSize" Value="{DynamicResource STControlFontSize14}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type control:IconButton}">
                    <Grid>
                        <Button
                            x:Name="PART_Button"
                            Padding="{TemplateBinding Padding}"
                            ui:ControlHelper.CornerRadius="{TemplateBinding ui:ControlHelper.CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Command="{TemplateBinding Command}"
                            CommandParameter="{TemplateBinding CommandParameter}"
                            AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                            ToolTip="{TemplateBinding ToolTip}"
                            Visibility="Visible">
                            <ui:FontIcon FontSize="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IconSize, Mode=TwoWay}" Icon="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Icon}" />
                        </Button>

                        <ToggleButton
                            x:Name="PART_ToggleButton"
                            Padding="{TemplateBinding Padding}"
                            ui:ControlHelper.CornerRadius="{TemplateBinding ui:ControlHelper.CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsOn}"
                            AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                            ToolTip="{TemplateBinding ToolTip}"
                            Visibility="Collapsed">
                            <ui:FontIcon FontSize="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IconSize, Mode=TwoWay}" Icon="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Icon}" />
                        </ToggleButton>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Type" Value="Toggle">
                            <Setter TargetName="PART_Button" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_ToggleButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource STIconButtonStyle}" TargetType="{x:Type control:IconButton}" />
</ResourceDictionary>
