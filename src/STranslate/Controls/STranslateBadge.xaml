<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:STranslate.Controls">

    <!-- 保留原资源类型和 256 DIP 绘制边界，让欢迎页与各空态继续使用同一布局。 -->
    <DrawingGroup x:Key="IconSvg">
        <ImageDrawing
            Rect="0,0,256,256"
            ImageSource="pack://application:,,,/STranslate;component/Resources/app-logo.png" />
    </DrawingGroup>

    <Style TargetType="{x:Type control:STranslateBadge}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type control:STranslateBadge}">
                    <Image Opacity="0.12" Stretch="None">
                        <Image.Source>
                            <DrawingImage Drawing="{StaticResource IconSvg}" />
                        </Image.Source>
                    </Image>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
